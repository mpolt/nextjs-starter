# MySQL/MariaDB connection string
# Docker Compose default (see compose.yaml):
DATABASE_URL="mysql://starter:starter@localhost:3306/starter"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google OAuth. Leave empty to hide the Google button.
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: this email becomes admin on signup (email or Google)
ADMIN_EMAIL=""
